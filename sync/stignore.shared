// EasyWork device-local dependency and build caches
(?d)/EasyWork/node_modules
(?d)/EasyWork/.cache
(?d)/EasyWork/.vinext
(?d)/EasyWork/.wrangler
(?d)/EasyWork/.next
(?d)/EasyWork/dist
(?d)/EasyWork/out
(?d)/EasyWork/outputs
(?d)/EasyWork/work
(?d)/EasyWork/coverage
(?d)/EasyWork/*.tsbuildinfo

// Device-local runtime logs and previews
(?d)/EasyWork/.dev-server.*.log
(?d)/EasyWork/.gateway.*.log
(?d)/EasyWork/.reference-chat.png
(?d)/EasyWork/frp/*.log

// FRP endpoint, token, proxy name and remote port are different per device
(?d)/EasyWork/frp/frpc.local.toml

// Persistent data is intentionally NOT ignored:
// EasyWork/data, EasyWork/skill, prompts and source files continue to sync.

