#!/bin/sh

set -eu

EASYWORK_HOME=${EASYWORK_HOME:-"$HOME/.easywork"}
RUN_ROOT="$EASYWORK_HOME/runs"

fail() {
  printf '%s\n' "easywork-runner: $*" >&2
  exit 1
}

require_run_id() {
  run_id=${1:-}
  case "$run_id" in
    ""|*[!A-Za-z0-9._-]*) fail "invalid run id" ;;
  esac
  [ "${#run_id}" -le 120 ] || fail "run id is too long"
  RUN_DIR="$RUN_ROOT/$run_id"
}

write_state() {
  key=$1
  value=$2
  temp="$RUN_DIR/.$key.$$"
  umask 077
  printf '%s\n' "$value" > "$temp"
  mv -f "$temp" "$RUN_DIR/$key"
}

read_state() {
  file=$1
  fallback=${2:-}
  if [ -f "$RUN_DIR/$file" ]; then
    sed -n '1p' "$RUN_DIR/$file"
  else
    printf '%s\n' "$fallback"
  fi
}

process_is_alive() {
  pid=$1
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

descendant_pids() {
  root_pid=$1
  ps -eo pid,ppid | awk -v root="$root_pid" '
    NR > 1 { parent[$1] = $2 }
    END {
      for (pid in parent) {
        current = pid
        delete seen
        while (current in parent && !seen[current]++) {
          if (parent[current] == root) {
            print pid
            break
          }
          current = parent[current]
        }
      }
    }
  '
}

process_group_id() {
  target_pid=$1
  set -- $(ps -o pgid= -p "$target_pid" 2>/dev/null)
  printf '%s\n' "${1:-}"
}

signal_process_tree() {
  signal_name=$1
  root_pid=$2
  descendants=$3
  groups=""
  for target_pid in $root_pid $descendants; do
    case "$target_pid" in
      ""|*[!0-9]*) continue ;;
    esac
    group_id=$(process_group_id "$target_pid")
    case "$group_id" in
      ""|*[!0-9]*) ;;
      *)
        case " $groups " in
          *" $group_id "*) ;;
          *) groups="$groups $group_id" ;;
        esac
        ;;
    esac
  done
  for group_id in $groups; do
    kill "-$signal_name" "-$group_id" 2>/dev/null || true
  done
  for target_pid in $descendants $root_pid; do
    kill "-$signal_name" "$target_pid" 2>/dev/null || true
  done
}

run_job() {
  require_run_id "${1:-}"
  [ -d "$RUN_DIR" ] || fail "run directory does not exist"
  [ -f "$RUN_DIR/command.sh" ] || fail "command.sh is missing"
  chmod 700 "$RUN_DIR/command.sh"
  write_state pid "$$"
  write_state pgid "$$"
  write_state status running
  write_state started_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  set +e
  sh "$RUN_DIR/command.sh" > "$RUN_DIR/stdout.log" 2> "$RUN_DIR/stderr.log"
  code=$?
  set -e
  write_state exit_code "$code"
  if [ "$code" -eq 0 ]; then
    write_state status done
  else
    current_status=$(read_state status running)
    if [ "$current_status" != aborted ]; then
      write_state status error
    fi
  fi
  write_state finished_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  exit "$code"
}

run_start() {
  require_run_id "${1:-}"
  umask 077
  mkdir -p "$RUN_ROOT" "$RUN_DIR"
  chmod 700 "$EASYWORK_HOME" "$RUN_ROOT" "$RUN_DIR" 2>/dev/null || true
  [ -f "$RUN_DIR/command.sh" ] || fail "command.sh is missing"

  status=$(read_state status new)
  pid=$(read_state pid "")
  if [ "$status" = running ] && process_is_alive "$pid"; then
    printf 'run_id=%s\nstatus=running\npid=%s\n' "$run_id" "$pid"
    return 0
  fi
  case "$status" in
    done|error|aborted) fail "run already reached terminal state: $status" ;;
  esac

  write_state status starting
  : > "$RUN_DIR/stdout.log"
  : > "$RUN_DIR/stderr.log"
  chmod 600 "$RUN_DIR/stdout.log" "$RUN_DIR/stderr.log"
  setsid "$0" __run-job "$run_id" </dev/null >/dev/null 2>&1 &
  pid=$!
  write_state pid "$pid"
  write_state pgid "$pid"
  printf 'run_id=%s\nstatus=starting\npid=%s\n' "$run_id" "$pid"
}

run_status() {
  require_run_id "${1:-}"
  [ -d "$RUN_DIR" ] || fail "run does not exist"
  status=$(read_state status unknown)
  pid=$(read_state pid "")
  if [ "$status" = starting ] || [ "$status" = running ]; then
    if ! process_is_alive "$pid"; then
      code=$(read_state exit_code "")
      if [ -n "$code" ]; then
        [ "$code" -eq 0 ] && status=done || status=error
      else
        status=lost
      fi
      write_state status "$status"
    fi
  fi
  printf 'run_id=%s\nstatus=%s\npid=%s\npgid=%s\nexit_code=%s\nstarted_at=%s\nfinished_at=%s\n' \
    "$run_id" \
    "$status" \
    "$pid" \
    "$(read_state pgid "")" \
    "$(read_state exit_code "")" \
    "$(read_state started_at "")" \
    "$(read_state finished_at "")"
}

run_cancel() {
  require_run_id "${1:-}"
  [ -d "$RUN_DIR" ] || fail "run does not exist"
  status=$(read_state status unknown)
  pid=$(read_state pid "")
  case "$status" in
    done|error|aborted|lost)
      run_status "$run_id"
      return 0
      ;;
  esac

  write_state status cancelling
  if process_is_alive "$pid"; then
    descendants=$(descendant_pids "$pid" | sort -rn || true)
    umask 077
    printf '%s\n' "$descendants" > "$RUN_DIR/cancelled_pids"
    signal_process_tree TERM "$pid" "$descendants"
    attempts=0
    while process_is_alive "$pid" && [ "$attempts" -lt 20 ]; do
      sleep 0.1
      attempts=$((attempts + 1))
    done
    signal_process_tree KILL "$pid" "$descendants"
  fi
  write_state status aborted
  write_state exit_code 130
  write_state finished_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  run_status "$run_id"
}

run_input() {
  require_run_id "${1:-}"
  [ -d "$RUN_DIR" ] || fail "run does not exist"
  input_fifo="$RUN_DIR/input.fifo"
  [ -p "$input_fifo" ] || fail "run does not accept live input"
  cat > "$input_fifo"
}

self_test() {
  missing=""
  for command_name in sh setsid kill date mkdir mv sed sleep chmod ps awk sort cat grep mkfifo; do
    command -v "$command_name" >/dev/null 2>&1 || missing="$missing $command_name"
  done
  if [ -n "$missing" ]; then
    printf 'status=error\nmissing=%s\n' "${missing# }"
    exit 1
  fi
  umask 077
  mkdir -p "$RUN_ROOT"
  chmod 700 "$EASYWORK_HOME" "$RUN_ROOT" 2>/dev/null || true
  printf 'status=ready\nprotocol=1\nshell=%s\nhome=%s\n' "${SHELL:-sh}" "$EASYWORK_HOME"
}

case "${1:-}" in
  self-test) self_test ;;
  run-start) run_start "${2:-}" ;;
  run-status) run_status "${2:-}" ;;
  run-cancel) run_cancel "${2:-}" ;;
  run-input) run_input "${2:-}" ;;
  __run-job) run_job "${2:-}" ;;
  *) fail "usage: easywork-runner {self-test|run-start|run-status|run-cancel|run-input} [run_id]" ;;
esac
