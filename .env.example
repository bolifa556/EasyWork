# Copy to .env in a release package. / 发布包中复制为 .env 即可加载。
# Source checkout: export these variables before npm start.
# 源码运行时请在启动前设置对应环境变量。

EASYWORK_WEB_PORT=8001
EASYWORK_WEB_INTERNAL_PORT=8002

# Store data outside the installation directory for easier upgrades.
# 建议设置为安装目录之外的绝对路径，便于升级时保留数据。
# EASYWORK_DATA_ROOT=/srv/easywork-data
# EASYWORK_DATA_ROOT=D:/EasyWorkData

# Comma-separated public URLs when using a reverse proxy.
# 使用反向代理时填写公开访问地址，多个地址以逗号分隔。
# EASYWORK_ALLOWED_ORIGINS=https://easywork.example.com
