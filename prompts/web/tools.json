{
  "tools": {
    "resource_search": {
      "description": "使用 Embedding 全面检索当前可用文件中与问题相关的正文；未配置 Embedding 时改用 resource_read 直接读取概览中的文件",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "resource_read": {
      "description": "不使用 Embedding，按文件概览中的精确文件名直接读取正文；长文件根据返回的下一读取位置继续读取，图片会同时提供给支持多模态的网页模型",
      "inputSchema": {
        "type": "object",
        "required": ["filename"],
        "properties": {
          "filename": { "type": "string" },
          "start": { "type": "integer" }
        },
        "additionalProperties": false
      }
    },
    "conversation_search": {
      "description": "查找当前网页对话中与问题相关的既有消息原文",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "roles": {
            "type": "array",
            "items": { "type": "string", "enum": ["user", "assistant"] }
          }
        },
        "additionalProperties": false
      }
    },
    "conversation_reference_search": {
      "description": "在用户本轮通过 @ 明确引用的 EasyWork 对话中检索相关历史背景；只能使用本轮目录给出的 reference_id。一次查询会返回该冻结边界内的相关记忆、最近上下文，以及必要的较早完整回合",
      "inputSchema": {
        "type": "object",
        "required": ["referenceId", "query"],
        "properties": {
          "referenceId": { "type": "string" },
          "query": { "type": "string" },
          "cursor": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "skill_search": {
      "description": "读取本轮 Skill 目录中一个名称完全一致的 Skill 正文；每次读取一个候选，存在多个相关候选时分别读取且同名不重复",
      "inputSchema": {
        "type": "object",
        "required": ["name", "query"],
        "properties": {
          "name": { "type": "string" },
          "query": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "handoff_rewrite_candidate": {
      "description": "临时整理一条记忆或明确 @ 引用的对话候选，再由 handoff_submit 发送；candidate_id 与原标题保持不变，整理内容仅本轮有效且不会回写来源",
      "inputSchema": {
        "type": "object",
        "required": ["candidateId", "revisedContent"],
        "properties": {
          "candidateId": { "type": "string" },
          "revisedContent": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "handoff_submit": {
      "description": "提交本轮需要交给远端 Agent 的候选补充。只选择完成用户目标确实需要、且远端自身上下文中未必已有的事实或操作规范。仅使用当前 candidate_id；没有相关内容或无需补充时提交空数组。原始用户请求会原样交付，不推测或补写未取得的信息",
      "inputSchema": {
        "type": "object",
        "required": ["candidateIds"],
        "properties": {
          "candidateIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
