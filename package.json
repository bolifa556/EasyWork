{
  "name": "easywork",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "start": "node scripts/run-vinext.mjs start",
    "gateway": "node gateway/server.mjs",
    "frp": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File frp/start.ps1",
    "sync:setup": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File sync/install.ps1",
    "test:gateway": "node --test tests/gateway.test.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/gateway.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .cache --ignore-pattern outputs --ignore-pattern work",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "adm-zip": "0.6.0",
    "drizzle-orm": "0.45.2",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.27.0",
    "mammoth": "1.12.0",
    "next": "16.2.6",
    "pdf-parse": "2.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ssh2": "1.17.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ssh2": "1.15.5",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
